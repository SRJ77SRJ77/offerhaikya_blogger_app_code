rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, create, update, delete:
        if request.auth != null
        && request.auth.uid == userId;
    }

    match /notifications/{notificationId} {
      allow read:
        if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /offerRequests/{requestId} {
      // Each authenticated/anonymous Firebase session can create only one
      // request document for a given calendar day. The app uses:
      // requestId = uid_YYYY-MM-DD
      allow create:
        if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'phone', 'request', 'dayKey', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.request is string
        && request.resource.data.dayKey is string
        && request.resource.data.createdAt is timestamp
        && requestId == request.resource.data.uid + '_' + request.resource.data.dayKey;
      allow read:
        if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
